SECRET_KEY=troque-esta-chave-em-producao
DATABASE_URL=sqlite:///uberapp.db
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp (Meta Cloud API) — cobrança de parcelas atrasadas
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=cobranca_atraso
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_API_VERSION=v20.0

# Consulta de débitos/multas do Detran-DF: credencial "client_credentials" que o
# próprio site (SPA) usa no navegador pra autenticar a chamada pública de débitos
# por chassi — não é login pessoal, não precisa de captcha nem sessão salva.
DETRAN_DF_CLIENT_ID=
DETRAN_DF_CLIENT_SECRET=

# Banco de produção (Render, "External Database URL") — usado só quando
# explicitamente apontado (ex.: consultar/gravar multas contra dados reais).
# NÃO é a DATABASE_URL padrão do app local.
DATABASE_URL_PRODUCAO=
